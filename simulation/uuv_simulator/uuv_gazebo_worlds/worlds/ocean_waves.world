      <pose>0 0 0 0 0 0</pose>
      <!-- 加入了自碰撞和运动学设置 -->
      <self_collide>0</self_collide>  <!-- 不启用自碰撞 -->
      <kinematic>1</kinematic>        <!-- 物理仿真运动学 -->
      <!-- 添加摩擦和反弹属性 -->
