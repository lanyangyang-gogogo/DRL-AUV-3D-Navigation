    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>100 1 100</size> <!-- 长101.5米，宽1米，高2米 -->
        </box>
      </geometry>
      <pose>0 0 0 0 0 0</pose>
      <material>
        <ambient>0.5 0.5 0.5 0</ambient>
        <diffuse>0.5 0.5 0.5 0</diffuse>
      </material>
    </visual>
  </link>
  <static>true</static>  <!-- 设置为静态物体 -->
</model>

